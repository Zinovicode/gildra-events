{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "declaration": true,
    "outDir": "typescript/dist",
    "rootDir": "typescript/src",
    "skipLibCheck": true
  },
  "include": ["typescript/src/**/*"]
}
